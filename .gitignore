# Extracted activations. Several GB, and fully regenerable with
# scripts/03_extract.py from the committed dataset generators.
activations/

# Generated narrative datasets. Regenerable with scripts/02_generate_dataset.py,
# which is deterministic given --seed. The pilot set is committed anyway, so a
# replication runs on byte identical narratives rather than on its own draw.
data/full/*.jsonl
data/long2/*.jsonl
data/tiny/*.jsonl

# Large arrays
*.npy
*.npz

# Run logs
results/*.log

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Installers and other large binaries that land in the working directory.
# Nothing here is part of the project.
*.exe
*.msi
*.dmg
*.zip
